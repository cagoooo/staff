rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Helper function: Check if user is authenticated
    function isAuthenticated() {
      return request.auth != null;
    }
    
    // Helper function: Check if user is admin
    // Note: Admin check is done by looking up user document that matches auth UID
    function isAdmin() {
      return request.auth != null 
        && exists(/databases/$(database)/documents/artifacts/default-app-id/public/data/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/artifacts/default-app-id/public/data/users/$(request.auth.uid)).data.role == 'admin';
    }

    // App data rules - main collection
    match /artifacts/{appId}/public/data/{collection}/{docId} {
      
      // ========================================
      // USERS COLLECTION
      // ========================================
      
      // Allow any authenticated user to read all users
      allow read: if isAuthenticated() && collection == 'users';
      
      // User can create their own document (Google login - UID matches docId)
      allow create: if isAuthenticated() 
        && collection == 'users'
        && docId == request.auth.uid;
      
      // User can update their own document (Google login)
      allow update: if isAuthenticated() 
        && collection == 'users' 
        && docId == request.auth.uid;
      
      // Admin can create, update, delete any user
      allow create, update, delete: if isAuthenticated() 
        && collection == 'users' 
        && isAdmin();
      
      // ========================================
      // EVENTS COLLECTION
      // ========================================
      
      // Any authenticated user can read events
      allow read: if isAuthenticated() && collection == 'school_events';
      
      // Any authenticated user can create events
      allow create: if isAuthenticated() 
        && collection == 'school_events';
      
      // Event author or admin can update/delete
      allow update, delete: if isAuthenticated() 
        && collection == 'school_events' 
        && (resource.data.authorId == request.auth.uid || isAdmin());
      
      // ========================================
      // TAGS COLLECTION
      // ========================================
      
      // Any authenticated user can read and create tags
      allow read, create: if isAuthenticated() && collection == 'tags';
      
      // Only admin can update/delete tags
      allow update, delete: if isAuthenticated() 
        && collection == 'tags' 
        && isAdmin();
      
      // ========================================
      // REMINDERS COLLECTION
      // ========================================
      
      // User can read their own reminders
      allow read: if isAuthenticated() 
        && collection == 'reminders'
        && resource.data.userId == request.auth.uid;
      
      // User can create reminders for themselves
      allow create: if isAuthenticated() 
        && collection == 'reminders'
        && request.resource.data.userId == request.auth.uid;
      
      // User can update/delete their own reminders
      allow update, delete: if isAuthenticated() 
        && collection == 'reminders'
        && resource.data.userId == request.auth.uid;
    }
    
    // ========================================
    // COMMENTS SUBCOLLECTION (under events)
    // ========================================
    match /artifacts/{appId}/public/data/school_events/{eventId}/comments/{commentId} {
      // Anyone can read comments
      allow read: if isAuthenticated();
      
      // Any authenticated user can create comments
      allow create: if isAuthenticated();
      
      // Only comment author can update
      allow update: if isAuthenticated() 
        && resource.data.authorId == request.auth.uid;
      
      // Comment author or admin can delete
      allow delete: if isAuthenticated() 
        && (resource.data.authorId == request.auth.uid || isAdmin());
    }
  }
}
