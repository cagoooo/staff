rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Default deny all
    match /{document=**} {
      allow read, write: if false;
    }
    
    // Check if user is admin
    function isAdmin() {
      return request.auth != null 
        && exists(/databases/$(database)/documents/artifacts/$(request.path[4])/public/data/users/$(request.auth.uid))
        && get(/databases/$(database)/documents/artifacts/$(request.path[4])/public/data/users/$(request.auth.uid)).data.role == 'admin';
    }

    // Check if user is document owner (by document ID)
    function isOwner(docId) {
      return request.auth != null && request.auth.uid == docId;
    }

    // App data rules
    match /artifacts/{appId}/public/data/{collection}/{docId} {
      
      // Allow read for authenticated users
      allow read: if request.auth != null;
      
      // Users collection - create only own document
      allow create: if request.auth != null 
        && collection == 'users'
        && docId == request.auth.uid;
      
      // Users collection - update own document
      allow update: if request.auth != null 
        && collection == 'users' 
        && isOwner(docId);
      
      // Admin can update any user
      allow update, delete: if request.auth != null 
        && collection == 'users' 
        && isAdmin();
      
      // Admin can create users
      allow create: if request.auth != null 
        && collection == 'users' 
        && isAdmin();
      
      // Events - create with author check
      allow create: if request.auth != null 
        && collection == 'school_events'
        && request.resource.data.authorId == request.auth.uid;
      
      // Events - update/delete for owner or admin
      allow update, delete: if request.auth != null 
        && collection == 'school_events' 
        && (resource.data.authorId == request.auth.uid || isAdmin());
      
      // Tags - anyone can read, any authenticated user can create
      allow read: if request.auth != null && collection == 'tags';
      allow create: if request.auth != null && collection == 'tags';
      
      // Tags - only admin can update/delete
      allow update, delete: if request.auth != null 
        && collection == 'tags' 
        && isAdmin();
    }
  }
}
